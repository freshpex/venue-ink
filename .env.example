DATABASE_URL=

DATABASE_URL_UNPOOLED=
JWT_SECRET=
SEED_ADMIN_EMAIL=admin@venue.com
SEED_ADMIN_PASSWORD=
PORT=3001
NODE_ENV=development
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001
VITE_API_URL=
SITE_URL=http://localhost:3001
COOKIE_SAME_SITE=lax

# Stable, independent key for MFA and queued email encryption (32+ random characters).
DATA_ENCRYPTION_KEY=
REQUIRE_STAFF_MFA=false
# Optional email delivery; without these the durable queue stays pending.
RESEND_API_KEY=
MAIL_FROM=
WORKER_ENABLED=true
# Hosted card checkout and signed provider webhooks; both are required.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Organization SSO (pre-provisioned accounts only).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOWED_DOMAINS=
